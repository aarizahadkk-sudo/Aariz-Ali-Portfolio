@model PortfolioApp.Models.LoginViewModel
@{
    ViewData["Title"] = "Secure Admin Sign-In";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="glass-panel rounded-4 p-4 p-md-5 border-slate-800 shadow-2xl">
                <div class="text-center mb-4">
                    <div class="d-inline-flex p-3 rounded-circle bg-gold-subtle text-gold mb-3 border border-gold-subtle">
                        <i class="bi bi-shield-lock-fill fs-2"></i>
                    </div>
                    <h1 class="h4 font-display text-white mb-1">Administrative Gateway</h1>
                    <p class="text-slate-400 small">ASP.NET Core Cookie-Authenticated Session</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 small">
                        <div asp-validation-summary="All" class="text-danger"></div>
                    </div>
                }

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-slate-300 small"></label>
                        <input asp-for="Email" class="form-control form-control-dark" placeholder="admin@portfolio.net" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label text-slate-300 small"></label>
                        <input asp-for="Password" class="form-control form-control-dark" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-slate-400 small"></label>
                    </div>

                    <button type="submit" class="btn btn-gold w-100 py-2 fw-semibold">
                        Authenticate &amp; Access Console
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top border-slate-800">
                    <a href="/" class="text-slate-400 text-decoration-none small hover-gold">
                        <i class="bi bi-arrow-left me-1"></i> Return to Public Portfolio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
