<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Aariz Ahad | Principal .NET Architect</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Dark Luxury & Glassmorphism CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-obsidian text-light">
    <!-- Navbar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg glass-nav py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                    <div class="brand-badge d-flex align-items-center justify-content-center">
                        <span class="text-gold fw-bold">.NET</span>
                    </div>
                    <span class="fw-bold tracking-tight text-white font-display">AARIZ AHAD</span>
                </a>
                <button class="navbar-toggler border-0 text-gold" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                    <i class="bi bi-list fs-2"></i>
                </button>
                <div class="collapse navbar-collapse" id="navContent">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-4">
                        <li class="nav-item"><a class="nav-link text-slate-300" href="/#about">About</a></li>
                        <li class="nav-item"><a class="nav-link text-slate-300" href="/#projects">Projects</a></li>
                        <li class="nav-item"><a class="nav-link text-slate-300" href="/#skills">Architecture</a></li>
                        <li class="nav-item"><a class="nav-link text-slate-300" href="/#contact">Contact</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a href="/Admin" class="btn btn-sm btn-outline-warning text-gold border-gold">
                                <i class="bi bi-shield-check me-1"></i> Admin Panel
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary text-slate-400">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a id="navGithubLink" href="https://github.com/aarizahad" target="_blank" class="btn btn-glass btn-sm px-3 text-slate-300">
                                <i class="bi bi-github me-1"></i> GitHub
                            </a>
                            <a id="navLinkedinLink" href="https://linkedin.com/in/aarizahad" target="_blank" class="btn btn-gold btn-sm px-3">
                                <i class="bi bi-linkedin me-1"></i> LinkedIn
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer with Hidden Padlock Icon at extreme bottom-left -->
    <footer class="footer-obsidian py-4 border-top border-slate-800 mt-5">
        <div class="container position-relative">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <!-- Subtle hidden padlock at extreme bottom-left -->
                    <button id="hiddenAdminLockBtn" class="btn-hidden-padlock" title="Administrative Access" aria-label="Administrative Access" data-bs-toggle="modal" data-bs-target="#adminAuthModal">
                        <i class="bi bi-lock-fill"></i>
                    </button>
                    <span class="text-slate-500 small">
                        &copy; @DateTime.UtcNow.Year Aariz Ahad. Built with ASP.NET Core &amp; EF Core.
                    </span>
                </div>
                <div class="d-flex gap-4">
                    <a href="/#about" class="text-slate-400 text-decoration-none small hover-gold">About</a>
                    <a href="/#projects" class="text-slate-400 text-decoration-none small hover-gold">Projects</a>
                    <a href="/#contact" class="text-slate-400 text-decoration-none small hover-gold">Contact</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Hidden Admin Auth Modal -->
    <div class="modal fade" id="adminAuthModal" tabindex="-1" aria-labelledby="adminAuthModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-modal border-slate-800">
                <div class="modal-header border-bottom border-slate-800">
                    <div class="d-flex align-items-center gap-2">
                        <div class="badge-gold-circle">
                            <i class="bi bi-shield-lock text-gold"></i>
                        </div>
                        <h5 class="modal-title text-white font-display" id="adminAuthModalLabel">Internal Security Gateway</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="hiddenLoginForm" method="post" action="/Account/Login">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">
                        <p class="text-slate-400 small mb-3">
                            Sign in with your verified administrative credentials to manage dynamic portfolio content, bio, and EF Core records.
                        </p>
                        <div id="loginErrorAlert" class="alert alert-danger d-none py-2 small" role="alert"></div>
                        <div class="mb-3">
                            <label for="adminEmail" class="form-label text-slate-300 small">Email Address</label>
                            <input type="email" class="form-control form-control-dark" id="adminEmail" name="Email" required placeholder="admin@portfolio.net" />
                        </div>
                        <div class="mb-3">
                            <label for="adminPassword" class="form-label text-slate-300 small">Password</label>
                            <input type="password" class="form-control form-control-dark" id="adminPassword" name="Password" required placeholder="••••••••" />
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="rememberMe" name="RememberMe" value="true">
                            <label class="form-check-label text-slate-400 small" for="rememberMe">
                                Keep session active on this workstation
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer border-top border-slate-800 p-3">
                        <button type="button" class="btn btn-glass btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-gold btn-sm px-4">Authenticate</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Client-side Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
